#pragma once

#include <vulkan/vulkan.h>

namespace vkts {
#define VKTS_VERSION_STRING "@VKTS_VERSION_STRING@"

#define VKTS_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define VKTS_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define VKTS_VERSION_PATCH @PROJECT_VERSION_PATCH@

#define VKTS_VERSION \
  VK_MAKE_VERSION( \
    VKTS_VERSION_MAJOR, \
    VKTS_VERSION_MINOR, \
    VKTS_VERSION_PATCH)
}